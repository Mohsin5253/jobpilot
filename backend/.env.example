# --- Core ---
ENV=dev
DATABASE_URL=postgresql+psycopg://localhost/jobpilot
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
APP_URL=http://localhost:3000
# Required in production (encrypts users' mail passwords). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Accounts that can open /admin (comma-separated)
ADMIN_EMAILS=
SENTRY_DSN=

# --- LLM. Groq by default (openai/gpt-oss-20b scores, openai/gpt-oss-120b writes).
# Leave the key empty to run the deterministic offline agents. Set LLM_PROVIDER=anthropic to use Claude.
LLM_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides (empty = provider defaults)
FAST_MODEL=
SMART_MODEL=
LLM_CONCURRENCY=4

# --- Job sources (fetched once for all users by the shared ingester) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=
HUNTER_API_KEY=
GITHUB_TOKEN=
DEMO_SOURCE=false

# --- Optional: WhatsApp daily digest (official Cloud API; see DEPLOY.md) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=jobpilot_daily_digest
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Research agent ---
RESEARCHER_ENABLED=true
RESEARCH_COOLDOWN_HOURS=20

# --- Worker ---
EMBEDDED_WORKER=true
WORKER_CONCURRENCY=2

# --- Optional: SYSTEM mail (password resets, new-match alerts) ---
# Applications are sent from each user's own mailbox, connected in Settings -> Your email.
# In production use a transactional provider (Resend / Postmark / SES); locally a Gmail app password works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Optional: Langfuse tracing ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Local showcase account (scripts/seed_demo.py); "Try the live demo" visitors get a private copy of it
DEMO_TEMPLATE_EMAIL=demo@example.com
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=jobpilot-demo
