{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "backend",
        "uvicorn",
        "app.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "frontend/node_modules/next/dist/bin/next",
        "dev",
        "frontend",
        "--port",
        "3100"
      ],
      "port": 3100
    }
  ]
}
